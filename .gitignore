# 依赖
node_modules/

# 构建产物（tsc 输出 + tsdown client bundle）
lib/

# 内部文档：设计取舍与历史记录，不随仓库分发
DOCS/

# 本地打包产物与临时脚本
*.tgz
old.mjs

# 排查/构建用的临时目录与脚本（不应入库）
# _compat/ 是为了绕开沙箱写不进既有 lib/ 而临时改道编译输出的目录；
# _probe/ 是解析 app.asar 用的；.acl-recovery/ 是 ACL 诊断留下的报告。
_compat/
_probe/
.acl-recovery/
scripts/_tmp-*.mjs

# npm 库不提交 lockfile（发布与 git 安装都不需要）
package-lock.json

# 环境与密钥
.env
.env.local

# 日志与增量编译缓存
*.log
*.tsbuildinfo

# 系统垃圾
.DS_Store
Thumbs.db

# 开发辅助
.playwright-mcp/
coverage/
